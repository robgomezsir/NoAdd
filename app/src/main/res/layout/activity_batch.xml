<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/batchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.noadd.app.AuroraView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/batchContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="30dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/batchBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_glass_chip"
                android:contentDescription="@string/batch_back"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_back"
                android:tint="?attr/noAddInk" />

            <TextView
                android:id="@+id/batchTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/batch_title"
                android:textColor="?attr/noAddInk"
                android:textSize="24sp" />

            <ImageButton
                android:id="@+id/batchMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_glass_chip"
                android:contentDescription="@string/menu_desc"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_menu"
                android:tint="?attr/noAddInk" />
        </LinearLayout>

        <TextView
            android:id="@+id/batchStep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:text="@string/batch_step_import"
            android:textAllCaps="true"
            android:textColor="?attr/noAddInkMuted"
            android:textSize="10sp" />

        <FrameLayout
            android:id="@+id/batchStepHost"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1">

            <!-- Passo 1: lista -->
            <ScrollView
                android:id="@+id/importPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/batch_import_intro"
                        android:textColor="?attr/noAddInkMuted"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/importFile"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/touch"
                            android:layout_weight="1"
                            android:background="@drawable/btn_glass"
                            android:backgroundTint="@null"
                            android:letterSpacing="0.01"
                            android:stateListAnimator="@null"
                            android:text="@string/batch_import_file"
                            android:textAllCaps="false"
                            android:textColor="?attr/noAddInk"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/pasteList"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/touch"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_glass"
                            android:backgroundTint="@null"
                            android:letterSpacing="0.01"
                            android:stateListAnimator="@null"
                            android:text="@string/batch_paste"
                            android:textAllCaps="false"
                            android:textColor="?attr/noAddInk"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/pickContact"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/touch"
                            android:layout_weight="1"
                            android:background="@drawable/btn_glass"
                            android:backgroundTint="@null"
                            android:letterSpacing="0.01"
                            android:stateListAnimator="@null"
                            android:text="@string/batch_pick_contact"
                            android:textAllCaps="false"
                            android:textColor="?attr/noAddInk"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/addManual"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/touch"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_glass"
                            android:backgroundTint="@null"
                            android:letterSpacing="0.01"
                            android:stateListAnimator="@null"
                            android:text="@string/batch_add_manual"
                            android:textAllCaps="false"
                            android:textColor="?attr/noAddInk"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/importSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_glass_chip"
                        android:lineSpacingExtra="2dp"
                        android:padding="14dp"
                        android:textColor="?attr/noAddInk"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/reviewSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/reviewTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="?attr/noAddInk"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/batch_review_hint"
                            android:textColor="?attr/noAddInkMuted"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:id="@+id/reviewList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/listSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/listTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="?attr/noAddInk"
                            android:textSize="15sp" />

                        <LinearLayout
                            android:id="@+id/listPreview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/listMore"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="?attr/noAddInkMuted"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/toMessage"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/touch"
                        android:layout_marginTop="22dp"
                        android:background="@drawable/btn_accent"
                        android:backgroundTint="@null"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.02"
                        android:stateListAnimator="@null"
                        android:text="@string/batch_next_message"
                        android:textAllCaps="false"
                        android:textColor="?attr/noAddAccentInk"
                        android:textSize="16sp" />
                </LinearLayout>
            </ScrollView>

            <!-- Passo 2: mensagem -->
            <ScrollView
                android:id="@+id/messagePanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/messageLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:labelFor="@id/batchMessage"
                        android:letterSpacing="0.16"
                        android:text="@string/batch_message_label"
                        android:textAllCaps="true"
                        android:textColor="?attr/noAddInkMuted"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/batchMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_glass_chip"
                        android:gravity="top|start"
                        android:hint="@string/batch_message_hint"
                        android:importantForAutofill="no"
                        android:inputType="textCapSentences|textMultiLine"
                        android:minLines="6"
                        android:padding="16dp"
                        android:textColor="?attr/noAddInk"
                        android:textColorHint="?attr/noAddInkMuted"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/loadTraining"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/btn_glass"
                        android:backgroundTint="@null"
                        android:letterSpacing="0.01"
                        android:stateListAnimator="@null"
                        android:text="@string/batch_training_load"
                        android:textAllCaps="false"
                        android:textColor="?attr/noAddInk"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/trainingSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="?attr/noAddInkMuted"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/batch_vars_hint"
                        android:textColor="?attr/noAddInkMuted"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/insertName"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_glass"
                            android:backgroundTint="@null"
                            android:letterSpacing="0.01"
                            android:stateListAnimator="@null"
                            android:text="@string/batch_insert_name"
                            android:textAllCaps="false"
                            android:textColor="?attr/noAddInk"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/insertFirst"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_glass"
                            android:backgroundTint="@null"
                            android:letterSpacing="0.01"
                            android:stateListAnimator="@null"
                            android:text="@string/batch_insert_first"
                            android:textAllCaps="false"
                            android:textColor="?attr/noAddInk"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_glass_panel"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/previewName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="?attr/noAddInk"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/previewText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="2dp"
                            android:textColor="?attr/noAddInk"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/previewNext"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/btn_glass"
                            android:backgroundTint="@null"
                            android:letterSpacing="0.01"
                            android:stateListAnimator="@null"
                            android:text="@string/batch_preview_next"
                            android:textAllCaps="false"
                            android:textColor="?attr/noAddInk"
                            android:textSize="13sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/previewWarning"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_hint"
                            android:lineSpacingExtra="2dp"
                            android:padding="12dp"
                            android:textColor="?attr/noAddInk"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/messageCounter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="?attr/noAddInkMuted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/linkWarning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_hint"
                        android:lineSpacingExtra="2dp"
                        android:padding="12dp"
                        android:text="@string/batch_link_warning"
                        android:textColor="?attr/noAddInk"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/templatesButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/btn_glass"
                        android:backgroundTint="@null"
                        android:letterSpacing="0.01"
                        android:stateListAnimator="@null"
                        android:text="@string/batch_templates"
                        android:textAllCaps="false"
                        android:textColor="?attr/noAddInk"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/backToImport"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/touch"
                            android:layout_weight="1"
                            android:background="@drawable/btn_glass"
                            android:backgroundTint="@null"
                            android:letterSpacing="0.01"
                            android:stateListAnimator="@null"
                            android:text="@string/batch_back_step"
                            android:textAllCaps="false"
                            android:textColor="?attr/noAddInk"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/toQueue"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/touch"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_accent"
                            android:backgroundTint="@null"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.02"
                            android:stateListAnimator="@null"
                            android:text="@string/batch_next_queue"
                            android:textAllCaps="false"
                            android:textColor="?attr/noAddAccentInk"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- Passo 3: fila -->
            <LinearLayout
                android:id="@+id/queuePanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_panel"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/progressText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="?attr/noAddInk"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/sessionText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/noAddInkMuted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="10dp"
                        android:max="100"
                        android:progressBackgroundTint="?attr/noAddHairline"
                        android:progressTint="?attr/noAddAccent" />

                    <TextView
                        android:id="@+id/countsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="?attr/noAddInkMuted"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/limitCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_hint"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/limitText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="2dp"
                        android:textColor="?attr/noAddInk"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/newSession"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/btn_glass"
                        android:backgroundTint="@null"
                        android:letterSpacing="0.01"
                        android:stateListAnimator="@null"
                        android:text="@string/batch_session_new"
                        android:textAllCaps="false"
                        android:textColor="?attr/noAddInk"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/currentCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_glass_panel"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.16"
                        android:text="@string/batch_current"
                        android:textAllCaps="true"
                        android:textColor="?attr/noAddInkMuted"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/currentName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?attr/noAddInk"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/currentPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="?attr/noAddInkMuted"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/markSent"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/btn_accent"
                        android:backgroundTint="@null"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.02"
                        android:stateListAnimator="@null"
                        android:text="@string/batch_mark_sent"
                        android:textAllCaps="false"
                        android:textColor="?attr/noAddAccentInk"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/skip"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_glass"
                            android:backgroundTint="@null"
                            android:letterSpacing="0.01"
                            android:stateListAnimator="@null"
                            android:text="@string/batch_skip"
                            android:textAllCaps="false"
                            android:textColor="?attr/noAddInk"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/openAgain"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_glass"
                            android:backgroundTint="@null"
                            android:letterSpacing="0.01"
                            android:stateListAnimator="@null"
                            android:text="@string/batch_open_again"
                            android:textAllCaps="false"
                            android:textColor="?attr/noAddInk"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="10dp"
                    android:layout_weight="1">

                    <ListView
                        android:id="@+id/batchList"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:clipToPadding="false"
                        android:divider="?attr/noAddHairline"
                        android:dividerHeight="1dp"
                        android:paddingBottom="12dp"
                        android:scrollbars="none" />

                    <TextView
                        android:id="@+id/batchEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:padding="24dp"
                        android:text="@string/batch_queue_empty"
                        android:textColor="?attr/noAddInkMuted"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </FrameLayout>

                <Button
                    android:id="@+id/openNext"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_accent"
                    android:backgroundTint="@null"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.02"
                    android:stateListAnimator="@null"
                    android:text="@string/batch_open_next"
                    android:textAllCaps="false"
                    android:textColor="?attr/noAddAccentInk"
                    android:textSize="16sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
