<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.noadd.app.AuroraView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="24dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/glassSheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_panel"
                android:orientation="vertical"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/batchButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_glass_chip"
                        android:clickable="true"
                        android:contentDescription="@string/action_batch"
                        android:focusable="true"
                        android:gravity="center"
                        android:minWidth="64dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/batch_title"
                        android:textColor="?attr/noAddInk"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/menuButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_glass_chip"
                        android:contentDescription="@string/menu_desc"
                        android:padding="12dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_menu"
                        android:tint="?attr/noAddInk" />
                </LinearLayout>

                <TextView
                    android:id="@+id/countryLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:labelFor="@id/countryView"
                    android:letterSpacing="0.16"
                    android:text="@string/label_country"
                    android:textAllCaps="true"
                    android:textColor="?attr/noAddInkMuted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/countryView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_glass_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="?attr/noAddInk"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/numberLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-medium"
                    android:labelFor="@id/phoneInput"
                    android:letterSpacing="0.16"
                    android:text="@string/label_number"
                    android:textAllCaps="true"
                    android:textColor="?attr/noAddInkMuted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/phoneInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:fontFamily="sans-serif-medium"
                    android:hint="@string/hint_number"
                    android:inputType="phone"
                    android:letterSpacing="0.01"
                    android:maxLines="1"
                    android:minHeight="@dimen/touch"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:textColor="?attr/noAddInk"
                    android:textColorHint="?attr/noAddInkMuted"
                    android:textSize="28sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="?attr/noAddHairline" />

                <TextView
                    android:id="@+id/messageLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:labelFor="@id/messageInput"
                    android:letterSpacing="0.16"
                    android:text="@string/label_message"
                    android:textAllCaps="true"
                    android:textColor="?attr/noAddInkMuted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/messageInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:gravity="top|start"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="2"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:textColor="?attr/noAddInk"
                    android:textColorHint="?attr/noAddInkMuted"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_hint"
                    android:padding="14dp"
                    android:textColor="?attr/noAddInk"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/openButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/btn_accent"
                    android:backgroundTint="@null"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.02"
                    android:stateListAnimator="@null"
                    android:text="@string/action_open"
                    android:textAllCaps="false"
                    android:textColor="?attr/noAddAccentInk"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/shareButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch"
                        android:layout_weight="1"
                        android:background="@drawable/btn_glass"
                        android:backgroundTint="@null"
                        android:letterSpacing="0.01"
                        android:stateListAnimator="@null"
                        android:text="@string/action_share"
                        android:textAllCaps="false"
                        android:textColor="?attr/noAddInk"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/copyButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_glass"
                        android:backgroundTint="@null"
                        android:letterSpacing="0.01"
                        android:stateListAnimator="@null"
                        android:text="@string/action_copy"
                        android:textAllCaps="false"
                        android:textColor="?attr/noAddInk"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/callButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch"
                        android:layout_weight="1"
                        android:background="@drawable/btn_glass"
                        android:backgroundTint="@null"
                        android:letterSpacing="0.01"
                        android:stateListAnimator="@null"
                        android:text="@string/action_call"
                        android:textAllCaps="false"
                        android:textColor="?attr/noAddInk"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/shortcutButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_glass"
                        android:backgroundTint="@null"
                        android:letterSpacing="0.01"
                        android:stateListAnimator="@null"
                        android:text="@string/action_shortcut"
                        android:textAllCaps="false"
                        android:textColor="?attr/noAddInk"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
